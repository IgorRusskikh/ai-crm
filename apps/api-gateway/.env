# AUTH SERVICE

AUTH_SERVICE_NAME=AUTH_SERVICE
AUTH_SERVICE_NAMESPACE=dev
AUTH_SERVICE_NODE_ID=auth-service
AUTH_SERVICE_TRANSPORTER=nats://localhost:4222

# API GATEWAY

API_GATEWAY_NAMESPACE=dev
API_GATEWAY_NODE_ID=api-gateway
API_GATEWAY_TRANSPORTER=nats://localhost:4222

# NEST

PORT=4001
GLOBAL_PREFIX=api-gateway/api

# REDIS

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0

# AUTH RATE LIMIT

AUTH_RETRIES=5
AUTH_RETRY_DELAY=900
AUTH_RETRY_DURATION=300
