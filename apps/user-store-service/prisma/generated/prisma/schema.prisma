generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(uuid())
  authId      String      @unique
  phoneNumber String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  UserStore   UserStore[]

  @@index([id])
  @@index([authId])
  @@index([phoneNumber])
  @@map("users")
}

model Store {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  MarketplaceToken MarketplaceToken[]
  UserStore        UserStore[]

  @@index([id])
  @@index([slug])
  @@map("stores")
}

model UserStore {
  id        String    @id @default(uuid())
  userId    String
  storeId   String
  role      StoreRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId, role])
  @@index([userId, storeId])
  @@map("user_stores")
}

model MarketplaceToken {
  id          String      @id @default(uuid())
  token       String
  marketplace Marketplace
  storeId     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, marketplace])
  @@map("marketplace_tokens")
}

enum Marketplace {
  WILDBERRIES
  OZON
  YANDEX
}

enum StoreRole {
  OWNER
  ADMIN
  MANAGER
  VIEWER
}
