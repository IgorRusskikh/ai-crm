# SERVICE
SERVICE_NAMESPACE=<пространство имен сервиса>
SERVICE_NODE_ID=<идентификатор узла сервиса>
SERVICE_TRANSPORTER=<URL транспортера сообщений>

# NEST
PORT=<порт для запуска сервиса>
GLOBAL_PREFIX=<глобальный префикс API>

# DATABASE
DATABASE=<тип базы данных>
DATABASE_HOST=<хост базы данных>
DATABASE_PORT=<порт базы данных>
DATABASE_USER=<имя пользователя базы данных>
DATABASE_PASSWORD=<пароль базы данных>
DATABASE_NAME=<название базы данных>
DATABASE_SCHEMA=<схема базы данных>
DATABASE_URL='${DATABASE}://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=${DATABASE_SCHEMA}'

# JWT
JWT_SECRET=<секретный ключ для JWT>
JWT_EXPIRATION_TIME=<время истечения JWT в секундах>
JWT_ALGORITHM=<алгоритм шифрования JWT>
ACCESS_TOKEN_EXPIRATION_TIME=<время жизни access токена в минутах>
REFRESH_TOKEN_EXPIRATION_TIME=<время жизни refresh токена в днях>
ACCESS_TOKEN_EXPIRATION_TIME_FOR_DB=<время жизни access токена в секундах для БД>
REFRESH_TOKEN_EXPIRATION_TIME_FOR_DB=<время жизни refresh токена в секундах для БД>

# KEYS
JWT_PUBLIC_KEY=<путь к публичному ключу JWT>
JWT_PRIVATE_KEY=<путь к приватному ключу JWT>

# CSRF RATE LIMIT
CSRF_RETRIES=<количество попыток для CSRF>
CSRF_RETRY_DELAY=<задержка между попытками CSRF в секундах>
CSRF_RETRY_DURATION=<продолжительность блокировки CSRF в секундах>